LXC_SSH_USER=root
LXC_SSH_KEY_FILE=/tmp/ssh-artifacts/id_ed25519
LXC_SSH_PRIVATE_KEY=NOT_GENERATED
SSH_HOST=${LXC_SSH_HOST}
